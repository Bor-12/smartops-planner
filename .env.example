# Copy this file to .env for local Docker usage.
# Do not commit real secrets.

POSTGRES_DB=smartops
POSTGRES_USER=smartops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

APP_PORT=8080
APP_IMAGE_TAG=local
SPRING_PROFILES_ACTIVE=

APP_SECURITY_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_SECURITY_JWT_EXPIRATION_SECONDS=86400
